              "raw": "{{baseUrl}}/dados/fake?linhas=100&semente=7",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dados",
                "fake"
              ],
              "query": [
                {
                  "key": "linhas",
                  "value": "100",
                  "description": "1 a 100000 (padrao 100)"
                },
                {
                  "key": "semente",
                  "value": "7",
                  "description": "Fixa o sorteio para reproduzir"
                },
                {
                  "key": "nome",
                  "value": "",
