          }
        }
      ]
    },
    {
      "name": "Modelo (treino & monitoramento)",
      "item": [
        {
          "name": "POST /modelo/recarregar",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/modelo/recarregar",
            "description": "Recarrega o binario do disco sem reiniciar o container."
          }
        },
        {
          "name": "POST /modelo/treinar",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/modelo/treinar?incluir_novos=true&promover=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "modelo",
                "treinar"
              ],
              "query": [
                {
                  "key": "incluir_novos",
                  "value": "true",
                  "description": "Concatena dados/novos ao treino"
                },
                {
                  "key": "promover",
                  "value": "true",
                  "description": "Promove o run para producao ao final"
                }
              ]
            },
            "description": "Re-treina (original + novos) e gera run versionado. SINCRONO — pode levar varios minutos (Optuna + CV)."
          }
        },
        {
          "name": "POST /modelo/monitorar",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/modelo/monitorar?retreinar=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "modelo",
                "monitorar"
              ],
              "query": [
                {
                  "key": "retreinar",
                  "value": "true",
                  "description": "Se houver drift, dispara retreino e promove so se Acc/AUC ok"
                }
              ]
            },
            "description": "Avalia drift do modelo em producao; envia e-mail e retreina condicionalmente."
          }
        },
        {
          "name": "POST /modelo/promover/{run_id}",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/modelo/promover/{{runId}}",
            "description": "Promove um run para producao (aprovacao humana). Substitua {{runId}} pelo ID do run."
          }
        },
        {
          "name": "GET /modelo/runs",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/modelo/runs",
            "description": "Historico de treinamentos e avaliacoes (conteudo do MANIFESTO.json)."
          }
        },
        {
          "name": "GET /modelo/runs/{run_id}/eda/{arquivo}",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/modelo/runs/{{runId}}/eda/{{edaArquivo}}",
            "description": "Retorna PNG da EDA de um run (revisao antes de promover). Ajuste runId e edaArquivo."
          }
        }
      ]
    }
